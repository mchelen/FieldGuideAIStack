---
/**
 * A small, deliberately limited icon set.
 *
 * Every icon here marks a distinction the reader acts on — is this a concept or
 * a product, is this term settled or contested, which section am I in. Nothing
 * decorative: an icon that repeats what the adjacent word already says costs
 * scanning effort and buys nothing.
 *
 * Inline SVG rather than a font or sprite sheet, so they inherit `currentColor`
 * and work in both themes without a second palette.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 16, class: className } = Astro.props;

const paths: Record<string, string> = {
  // An open book — a concept is something you look up.
  concept: 'M12 6.5C10.5 5.2 8.6 4.5 6 4.5H3.5v13H6c2.6 0 4.5.7 6 2 1.5-1.3 3.4-2 6-2h2.5v-13H18c-2.6 0-4.5.7-6 2Zm0 0v14',
  // A box — a product is a thing that ships.
  product: 'M12 3 3.5 7.2v9.6L12 21l8.5-4.2V7.2L12 3Zm0 0 8.5 4.2M12 3 3.5 7.2m8.5 4.3v9.5m0-9.5 8.5-4.3m-8.5 4.3L3.5 7.2',
  // Stacked layers — several products sold as one family.
  suite: 'M12 3 3 7.5l9 4.5 9-4.5L12 3ZM3 12.5 12 17l9-4.5M3 17 12 21.5 21 17',
  // Three linked nodes — relations.
  relations: 'M6 7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm12 14a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm-12 0a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5ZM6 7.5v9m0 0 12-.5',
  // A tag — what each vendor calls it.
  naming: 'M3.5 10.8V4.5a1 1 0 0 1 1-1h6.3a1 1 0 0 1 .7.3l8 8a1 1 0 0 1 0 1.4l-6.3 6.3a1 1 0 0 1-1.4 0l-8-8a1 1 0 0 1-.3-.7Zm3.9-3.4h.01',
  // Binoculars — spotting one in the wild, which is what a field guide is for.
  wild: 'M7 20a3.5 3.5 0 0 1-3.4-4.3l1.7-7.4A2 2 0 0 1 7.2 6.8h1.3a1 1 0 0 1 1 1V16m5.5 4a3.5 3.5 0 0 0 3.4-4.3l-1.7-7.4a2 2 0 0 0-1.9-1.5h-1.3a1 1 0 0 0-1 1V16m-1.2 0h3.4M7 20a3.5 3.5 0 0 0 3.5-3.5V16m6.5 4a3.5 3.5 0 0 1-3.5-3.5V16',
  // A target — the situation it shows up in.
  usecase: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-4.5a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9Zm0-3.5a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z',
  // A quotation block — where the claim came from.
  sources: 'M4 5.5h16M4 10h10M4 14.5h16M4 19h10',
  // A settled term.
  standard: 'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-3.8-9.2 2.6 2.6 5-5',
  // An unequal sign — these words are used for the same thing but are not the
  // same word. Legible at 13px, where diverging arrows turned to mush.
  contested: 'M4.5 9.5h15M4.5 14.5h15M16.5 3.5 7.5 20.5',
  // Lines of a list — the section nav.
  contents: 'M8 6.5h12M8 12h12M8 17.5h12M4 6.5h.01M4 12h.01M4 17.5h.01',
  // A radiating node — the neighbourhood diagram.
  diagram: 'M12 14.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm0-5V4m0 10.5V20m2.2-6.8 4 3M7.8 10.8l-4-3m0 9 4-3m10.4-3-4-3',
};

const d = paths[name] ?? paths.concept;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={d} />
</svg>
