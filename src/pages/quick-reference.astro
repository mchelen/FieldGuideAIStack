---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { CARDS } from '../../scripts/lib/quick-reference-cards.mjs';
import { idsIn } from '../../scripts/lib/quick-reference-view.mjs';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The same markup each PNG is a screenshot of, inlined rather than shown as an
// <img>: on the page the boxes are real links to the pages behind them, the
// text is selectable and searchable, and dark mode is honoured. `?raw` resolves
// at build time; a runtime read would look relative to dist/ and fail.
// Generated by `npm run quick-ref`; check:output fails if the two disagree.
const fragments = import.meta.glob('../generated/*.html', { query: '?raw', import: 'default', eager: true });
// Ordered and titled from the generator's own card list, so adding a card to
// that file is the only edit needed to publish one.
const cards = CARDS.map((c) => ({
  ...c,
  anchor: c.slug.replace(/^quick-reference-?/, '') || 'stack',
  html: fragments[`../generated/${c.slug}.html`],
}));
const missing = cards.filter((c) => !c.html).map((c) => c.slug);
if (missing.length) throw new Error(`no generated fragment for: ${missing.join(', ')} — run npm run quick-ref`);
// Counted rather than claimed, so the prose below cannot drift as cards change.
const named = new Set(CARDS.flatMap(idsIn)).size;
const words = ['no', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
---

<Base
  title="Quick reference — Field Guide to the AI Stack"
  description="Four one-page diagrams of the AI stack: the layers, the agentic loop, what fills the context window, and what goes wrong. Made to be shared."
>
  <div class="wrap" style="padding-block:2.5rem 3rem">
    <h1>Quick reference</h1>
    <p class="lede">
      {words[cards.length] ?? cards.length} one-page diagrams, each answering a
      question the rest of the guide answers at length. Made to be shared: take
      the image, or link the page. Every box is a link to the concept behind it.
    </p>

    <nav class="qr-toc">
      {cards.map((c) => <a href={`#${c.anchor}`}>{c.title}</a>)}
    </nav>

    {cards.map((c) => (
      <section class="qr-card">
        {/* The diagram carries its own title and standfirst; this heading is
            here to be linked to and to appear in the contents above. */}
        <h2 id={c.anchor} class="qr-anchor">{c.title}</h2>
        <div class="qr-frame"><div class="qr-scale" set:html={c.html} /></div>
        <p class="qr-actions">
          <a class="qr-btn" href={`${base}/${c.slug}.png`} download>
            <Icon name="diagram" size={14} /> PNG
          </a>
          <a class="qr-btn" href={`${base}/${c.slug}.pdf`} download>
            <Icon name="diagram" size={14} /> PDF
          </a>
          <span class="qr-note">3200 × 1800 raster, or vector for slides</span>
        </p>
      </section>
    ))}

    <h2 id="what-they-leave-out"><Icon name="contents" /> What they leave out</h2>
    <p>
      Between them these name {named} concepts out of {' '}
      <a href={`${base}/`}>a hundred and sixty-six</a>. They are shapes, not an
      index — every box has a page behind it with a definition, a dated source,
      and what it is often confused with. All four are free to reuse with
      attribution.
    </p>
  </div>
</Base>

<script>
  // Each diagram is authored at a fixed 1600x900 so the page and the shared
  // image stay the same artifact. Scaling them here is what keeps them the
  // same, rather than maintaining a second responsive layout that could
  // disagree. `zoom` rather than `transform` because zoom resizes the layout
  // box, so each frame's height and sideways scroll stay correct with no
  // arithmetic. Where zoom is unsupported the assignment is inert and the frame
  // scrolls at full size, which is why the CSS starts scrollable.
  const frames = [...document.querySelectorAll<HTMLElement>('.qr-frame')];
  const host = frames[0]?.parentElement?.parentElement;
  if (frames.length && host) {
    // Floored, because a phone-width fit would put these at a quarter size and
    // nothing on them would be readable. Below the floor they scroll instead.
    const fit = () => {
      for (const frame of frames) {
        const inner = frame.firstElementChild as HTMLElement | null;
        if (inner) inner.style.zoom = String(Math.min(1, Math.max(0.52, frame.clientWidth / 1600)));
      }
    };
    new ResizeObserver(fit).observe(host);
    fit();
  }
</script>

<style>
  .qr-toc { display: flex; flex-wrap: wrap; gap: 0.5rem 0.9rem; margin: 1.4rem 0 0.5rem; font-size: 0.92rem; }
  .qr-toc a { color: var(--ink-soft); }
  .qr-toc a:hover { color: var(--accent); }
  .qr-card { margin-top: 2.6rem; }
  .qr-card h2.qr-anchor { margin-bottom: 0.2rem; scroll-margin-top: 4.5rem; }
  .qr-frame {
    margin: 1rem 0 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow-x: auto;
    background: var(--bg-raised);
  }
  .qr-scale { width: 1600px; }
  .qr-actions { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; margin: 0; }
  .qr-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: 7px;
    padding: 0.32rem 0.7rem;
    text-decoration: none;
    font-size: 0.88rem;
    color: var(--ink);
  }
  .qr-btn:hover { border-color: var(--accent); color: var(--accent); }
  .qr-note { color: var(--ink-faint); font-size: 0.85rem; }
</style>
