---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The same markup the PNG is a screenshot of, inlined rather than shown as an
// <img>: on the page the boxes are real links to the pages behind them, the
// text is selectable and searchable, and dark mode is honoured. `?raw` resolves
// at build time; a runtime read would look relative to dist/ and fail.
// Generated by `npm run quick-ref`; check:output fails if the two disagree.
import diagram from '../generated/quick-reference.html?raw';
---

<Base
  title="Quick reference — Field Guide to the AI Stack"
  description="One request and every layer it passes through: surface, harness, inference API, model. A shareable one-page diagram of the AI stack."
>
  <div class="wrap" style="padding-block:2.5rem 3rem">
    <h1>Quick reference</h1>
    <p class="lede">
      The whole stack on one page, following a single request from the window
      you typed in down to the weights and back. Made to be shared: take the
      image, or link this page. Every box here is a link.
    </p>

    <div class="qr-frame"><div class="qr-scale" set:html={diagram} /></div>

    <p class="qr-actions">
      <a class="qr-btn" href={`${base}/quick-reference.png`} download>
        <Icon name="diagram" size={14} /> Download PNG
      </a>
      <a class="qr-btn" href={`${base}/quick-reference.pdf`} download>
        <Icon name="diagram" size={14} /> Download PDF
      </a>
      <span class="qr-note">
        3200 × 1800 raster, or vector for slides · free to reuse with attribution
      </span>
    </p>

    <h2><Icon name="contents" /> What it leaves out</h2>
    <p>
      Seventeen concepts out of {' '}
      <a href={`${base}/`}>a hundred and sixty-six</a>. It is the shape of the
      stack, not an index — every box has a page behind it with a definition, a
      dated source, and what it is often confused with. The layers it draws are
      the ones worth getting right first, because nearly every other question
      turns on which layer a thing belongs to.
    </p>
  </div>
</Base>

<script>
  // The diagram is authored at a fixed 1600x900 so the page and the shared
  // image stay the same artifact; scaling it here is what keeps them the same,
  // rather than maintaining a second responsive layout that could disagree.
  // `zoom` rather than `transform` because zoom resizes the layout box, so the
  // frame's own height and its sideways scroll stay correct with no arithmetic.
  // Where zoom is unsupported the assignment is inert and the frame scrolls at
  // full size, which is why the CSS starts scrollable.
  const frame = document.querySelector<HTMLElement>('.qr-frame');
  const inner = frame?.querySelector<HTMLElement>('.qr-scale');
  if (frame && inner && frame.parentElement) {
    // Floored, because a phone-width fit would put this at a quarter size and
    // nothing on it would be readable. Below the floor it scrolls instead.
    const fit = () => {
      inner.style.zoom = String(Math.min(1, Math.max(0.52, frame.clientWidth / 1600)));
    };
    new ResizeObserver(fit).observe(frame.parentElement);
    fit();
  }
</script>

<style>
  .qr-frame {
    margin: 1.8rem 0 1rem;
    border: 1px solid var(--rule);
    border-radius: 10px;
    overflow-x: auto;
    background: var(--bg-raised);
  }
  .qr-scale { width: 1600px; }
  .qr-actions { display: flex; flex-wrap: wrap; gap: 0.6rem 1rem; align-items: center; }
  .qr-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--rule-strong);
    border-radius: 7px;
    padding: 0.4rem 0.8rem;
    text-decoration: none;
    font-size: 0.9rem;
    color: var(--ink);
  }
  .qr-btn:hover { border-color: var(--accent); color: var(--accent); }
  .qr-note { color: var(--ink-faint); font-size: 0.85rem; }
</style>
