---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Neighborhood from '../../components/Neighborhood.astro';
import Icon from '../../components/Icon.astro';
import PageNav from '../../components/PageNav.astro';
import { loadGraph } from '../../lib/graph';
import FictionMark from '../../components/FictionMark.astro';
import Altitude from '../../components/Altitude.astro';
import { scenariosByConcept } from '../../lib/fieldwork';

export async function getStaticPaths() {
  const graph = await loadGraph();
  return graph.nodes.map((n) => ({
    params: { id: n.id },
    props: { id: n.id },
  }));
}

const { id } = Astro.props;
const graph = await loadGraph();
const entry = graph.byId.get(id)!;
const { Content, headings } = await render(entry);
const fieldwork = (await scenariosByConcept()).get(id) ?? [];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const fmt = (d: Date) => d.toISOString().slice(0, 10);

// Bare strings are informal synonyms; objects are sourced vendor naming.
const aliases = entry.data.aka;
const plainAliases = aliases.filter((a): a is string => typeof a === 'string');
const vendorAliases = aliases.filter((a) => typeof a !== 'string');

// The section list is assembled in the order the sections actually render, so
// the nav cannot drift out of sync with the page by being maintained by hand.
const sections = [
  { id: 'diagram', label: 'What it touches', icon: 'diagram' },
  ...headings
    .filter((h) => h.depth === 2)
    .map((h) => ({ id: h.slug, label: h.text, icon: 'concept' })),
  vendorAliases.length > 0 && {
    id: 'vendor-naming',
    label: 'What each vendor calls it',
    icon: 'naming',
  },
  entry.data.useCase && { id: 'use-case', label: 'In use', icon: 'usecase' },
  { id: 'relations', label: 'Relations', icon: 'relations' },
  entry.data.examples.length > 0 && {
    id: 'in-the-wild',
    label: 'In the wild',
    icon: 'wild',
  },
  fieldwork.length > 0 && {
    id: 'fieldwork',
    label: 'Seen in the field',
    icon: 'fieldwork',
  },
  entry.data.sources.length > 0 && {
    id: 'sources',
    label: 'Sources',
    icon: 'sources',
  },
].filter(Boolean) as { id: string; label: string; icon: string }[];

const kindLabel: Record<string, string> = {
  concept: 'Concept',
  product: 'Product',
  suite: 'Product family',
};

const canonicalLabel: Record<string, string> = {
  standard: 'Defined by a standard',
  'de-facto': 'De facto standard term',
  contested: 'No agreed term — vendors differ',
  none: 'No established term',
};
const relations = graph.neighborsOf(id);
const authored = relations.filter((r) => !r.derived);
const derived = relations.filter((r) => r.derived);
---

<Base title={`${entry.data.title} — Field Guide to the AI Stack`} description={entry.data.summary}>
  <div class="wrap node-shell">
  <div class="node-main">
  <div style="padding-block: 2.5rem 1rem">
    <h1>{entry.data.title}</h1>
    <p class="kindline">
      <span class={`kind-badge is-${entry.data.kind}`}>
        <Icon name={entry.data.kind} size={13} />
        {kindLabel[entry.data.kind]}
      </span>
      {entry.data.vendor && <span class="vendor-name">{entry.data.vendor}</span>}
      {
        (entry.data.kind === 'product' || entry.data.kind === 'suite') && (
          <a href={`${base}/compare`}>compare with the others</a>
        )
      }
    </p>
    {
      plainAliases.length > 0 && (
        <p class="lede" style="font-size:0.95rem;margin-bottom:0.8rem">
          Also called: {plainAliases.join(', ')}
        </p>
      )
    }
    <p class="lede">{entry.data.summary}</p>
    <ul class="chips">
      {entry.data.tags.map((t) => (
        <li><a class="chip" href={`${base}/#tag-${t}`}>{t}</a></li>
      ))}
    </ul>

    <Altitude id={id} graph={graph} />

    {
      entry.data.canonical && (
        <div class={`canonical is-${entry.data.canonical.status}`}>
          <strong>
            <Icon
              name={
                entry.data.canonical.status === 'standard' ||
                entry.data.canonical.status === 'de-facto'
                  ? 'standard'
                  : 'contested'
              }
              size={13}
            />
            {canonicalLabel[entry.data.canonical.status]}
          </strong>
          {
            entry.data.canonical.term && (
              <p class="term">
                “{entry.data.canonical.term}”
                {entry.data.canonical.body && <span class="body"> · {entry.data.canonical.body}</span>}
              </p>
            )
          }
          {entry.data.canonical.note && <p class="note">{entry.data.canonical.note}</p>}
          {
            entry.data.canonical.url && (
              <p class="ref">
                <span class="ref-label">
                  {entry.data.canonical.status === 'standard' ||
                  entry.data.canonical.status === 'de-facto'
                    ? 'Reference'
                    : 'Nearest reference'}:
                </span>{' '}
                <a href={entry.data.canonical.url}>{entry.data.canonical.title}</a>
                {entry.data.canonical.verifiedOn && (
                  <span class="when"> — read {fmt(entry.data.canonical.verifiedOn)}</span>
                )}
              </p>
            )
          }
        </div>
      )
    }

    {
      entry.data.fieldMark && (
        <div class="fieldmark">
          <strong>Field mark</strong>
          {entry.data.fieldMark}
        </div>
      )
    }
  </div>

  <div id="diagram">
    <Neighborhood graph={graph} id={id} />
  </div>

  <div class="prose">
    <Content />

    {
      vendorAliases.length > 0 && (
        <>
          <h2 id="vendor-naming"><Icon name="naming" /> What each vendor calls it</h2>
          <p style="color:var(--ink-soft);font-size:0.95rem">
            The same idea under different names. Knowing the mapping is most of
            what it takes to read one vendor's documentation while using another's
            product.
          </p>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>Term</th>
                  <th>Used by</th>
                  <th>Checked</th>
                </tr>
              </thead>
              <tbody>
                {vendorAliases.map((a: any) => (
                  <tr>
                    <td>
                      <a href={a.url}>{a.term}</a>
                      {a.note && <div style="color:var(--ink-soft);font-size:0.85em">{a.note}</div>}
                    </td>
                    <td>{a.usedBy}</td>
                    <td style="font-family:var(--font-mono);font-size:0.8rem;white-space:nowrap">
                      {fmt(a.verifiedOn)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {
      entry.data.useCase && (
        <>
          <h2 id="use-case"><Icon name="usecase" /> What it looks like in use</h2>
          <div class="usecase">
            <p class="scenario">{entry.data.useCase.scenario}</p>
            <p class="detail">{entry.data.useCase.detail}</p>
          </div>
        </>
      )
    }

    <h2 id="relations"><Icon name="relations" /> Relations</h2>
    <ul class="rel-list">
      {authored.map((r) => (
        <li>
          <span class="rel-verb">{r.label}</span>
          <a href={`${base}/nodes/${r.to}/`}>{graph.byId.get(r.to)!.data.title}</a>
          {r.support === 'partial' && <span class="partial-flag">partial</span>}
          {r.note && <span class="rel-note">{r.note}</span>}
        </li>
      ))}
    </ul>
    {
      derived.length > 0 && (
        <>
          <h3>Referenced by</h3>
          <ul class="rel-list">
            {derived.map((r) => (
              <li>
                <span class="rel-verb">{r.label}</span>
                <a href={`${base}/nodes/${r.to}/`}>{graph.byId.get(r.to)!.data.title}</a>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      entry.data.examples.length > 0 && (
        <>
          <h2 id="in-the-wild"><Icon name="wild" /> In the wild</h2>
          <div class="table-scroll">
            <table>
              <thead>
                <tr>
                  <th>What</th>
                  <th>Why it is an example</th>
                  <th>Checked</th>
                </tr>
              </thead>
              <tbody>
                {entry.data.examples.map((ex) => (
                  <tr>
                    <td>
                      <a href={ex.url}>{ex.name}</a>
                      {ex.vendor && <div style="color:var(--ink-faint);font-size:0.85em">{ex.vendor}</div>}
                    </td>
                    <td>{ex.note}</td>
                    <td class="when" style="font-family:var(--font-mono);font-size:0.8rem;white-space:nowrap">
                      {fmt(ex.verifiedOn)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </>
      )
    }

    {
      fieldwork.length > 0 && (
        <>
          <h2 id="fieldwork"><Icon name="fieldwork" /> Seen in the field</h2>
          <FictionMark variant="inline" />
          <ul class="rel-list">
            {fieldwork.map((s) => (
              <li>
                <a href={`${base}/fieldwork/${s.id}/`}>{s.data.title}</a>
                <span class="rel-note">{s.data.summary}</span>
              </li>
            ))}
          </ul>
        </>
      )
    }

    {
      entry.data.sources.length > 0 && (
        <>
          <h2 id="sources"><Icon name="sources" /> Sources</h2>
          <ol class="sources">
            {entry.data.sources.map((s) => (
              <li id={`src-${s.id}`}>
                <a href={s.url}>{s.title}</a>
                <span class="when"> — read {fmt(s.verifiedOn)}</span>
                {/* The sentence the claim rests on, so a reader can judge it
                    without leaving the page — and the same text the weekly job
                    re-fetches to decide whether the date can still stand. */}
                {s.quote && <blockquote class="src-quote">{s.quote}</blockquote>}
                {s.note && <div class="caveat">{s.note}</div>}
              </li>
            ))}
          </ol>
        </>
      )
    }
    </div>
  </div>
  <PageNav sections={sections} />
  </div>
</Base>
