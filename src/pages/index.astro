---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { loadGraph, tagIndex } from '../lib/graph';

const graph = await loadGraph();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Subjects, across the whole guide rather than the concepts alone. Restricting
// them to concepts was the first attempt and it stranded `assistant`, which
// three product pages carry and no concept does: the chips on those pages
// pointed at a filter that did not offer the subject, and `check:output` says
// so. The level control still applies to the concepts only -- levels are how
// deep into the vocabulary you are, subjects are which part of the guide.
// `check:tags` is what keeps this list browsable: every entry has at least
// three pages and names a subject rather than a kind or a level.
const subjects = tagIndex(graph).sort(
  (a, b) => b.count - a.count || a.tag.localeCompare(b.tag),
);

const concepts = graph.nodes.filter((n) => n.kind === 'concept');
const products = graph.nodes.filter((n) => n.kind === 'product');
const suites = graph.nodes
  .filter((n) => n.kind === 'suite')
  .sort((a, b) => (a.vendor ?? '').localeCompare(b.vendor ?? ''));

const byVendor = [...new Set(products.map((p) => p.vendor ?? '—'))]
  .sort()
  .map((vendor) => ({
    vendor,
    nodes: products
      .filter((p) => (p.vendor ?? '—') === vendor)
      .sort((a, b) => a.title.localeCompare(b.title)),
  }));

// One list, ordered so that raising the level appends rather than reshuffles:
// a node declares the coarsest level it belongs at, so level 2 means "1 and 2",
// which is what the graph explorer has always meant by it. The index used to
// show the three as disjoint groups, so the two views disagreed about what
// "zoom 2" was.
const byZoom = concepts
  .slice()
  .sort((a, b) => a.zoom - b.zoom || b.degree - a.degree || a.title.localeCompare(b.title));

// Three rungs of one ladder, described by who is standing on them rather than
// by a number. Zooming in means getting more specialised, so each level says
// what it adds and each is cumulative.
const LEVELS = [
  {
    zoom: 1,
    label: 'Start here',
    for: 'new to this',
    blurb:
      'The terms the rest of the guide is written in. Nearly every other page explains itself using these, so they repay learning first.',
    adds: 'The terms everything else is defined against',
  },
  {
    zoom: 2,
    label: 'Working vocabulary',
    for: 'reading release notes',
    blurb:
      'Enough to follow an announcement or a product page without guessing. The first level, plus everything built directly on it.',
    adds: 'What is built on the first level',
  },
  {
    zoom: 3,
    label: 'Everything',
    for: 'going deep',
    blurb:
      'The specialist detail — worth looking up when you hit it, not worth reading through. Every concept in the guide.',
    adds: 'Specialist detail, for when you hit it',
  },
].map((l) => ({ ...l, count: concepts.filter((n) => n.zoom <= l.zoom).length }));
---

<Base
  title="Field Guide to the AI Stack"
  description="A field guide to the terms in the modern AI stack — what each one means, how they relate, and how to tell them apart in the wild."
>
  <div class="wrap narrow" style="padding-block: 3rem 0">
    <h1>A field guide to the AI stack</h1>
    <p class="lede">
      A model is not a harness. A provider is not a host. Open weights are not
      open source. This guide gives each term one page, one diagram of what it
      touches, and a dated source for every claim about a real product.
    </p>
    <p class="lede" style="font-size:1rem">
      {concepts.length} concepts · {products.length} products ·
      {graph.edges.filter((e) => !e.derived).length} relations ·
      <a href={`${base}/compare`}>compare the products</a> ·
      <a href={`${base}/graph`}>see the whole graph</a> ·
      <a href={`${base}/fieldwork/`}>watch them happen to somebody</a> ·
      <a href={`${base}/quick-reference`}>the whole stack on one page</a>
    </p>
  </div>

  <div class="wrap">
    <section style="margin-top:2.6rem" id="concepts">
      <h2 style="margin-bottom:0.2rem"><Icon name="concept" /> The concepts</h2>
      {/* Every card is rendered; the control hides the finer ones. Without
          JavaScript you get all of them, which is the honest fallback for an
          index — a filter that fails closed would hide most of the guide. */}
      <div class="zoom-control" role="group" aria-label="Level of detail">
        {LEVELS.map((l) => (
          <button type="button" data-zoom={l.zoom} aria-pressed={l.zoom === 3 ? 'true' : 'false'}>
            {l.label} <span class="zoom-count">{l.count}</span>
            <span class="zoom-for">{l.for}</span>
          </button>
        ))}
      </div>
      <p class="zoom-blurb" data-blurbs={JSON.stringify(LEVELS.map((l) => l.blurb))}>
        {LEVELS[2].blurb}
      </p>
      {/* The second axis, and deliberately not a second ladder: subjects
          overlap, so `sandbox` is under both `agentic` and `safety` and picking
          one never hides it from the other. Rendered as links so the list still
          works with JavaScript off -- each one lands on this page with the
          subject in the hash, and the script below picks it up. */}
      <div class="subject-control" role="group" aria-label="Subject">
        {/* No count on this one: it clears the subject rather than naming one,
            and it leaves the level alone, so any number next to it would be
            claiming something the level control can contradict. */}
        <a href="#subject=all" data-subject="all" aria-current="true">Any subject</a>
        {subjects.map((t) => (
          <a href={`#subject=${t.tag}`} data-subject={t.tag} aria-current="false">
            {t.tag} <span class="zoom-count">{t.count}</span>
          </a>
        ))}
      </div>
      {/* A rule before each level's first card, so the ladder stays visible
          instead of the list simply getting longer. Hidden with its own level
          by the same filter. */}
      <ul class="cards" id="concept-cards">
        {byZoom.map((n, i) => (
          <>
            {(i === 0 || byZoom[i - 1].zoom !== n.zoom) && (
              <li class="level-rule" data-zoom={n.zoom}>
                <span>Level {n.zoom}</span> {LEVELS[n.zoom - 1].adds}
              </li>
            )}
          <li class="card" data-zoom={n.zoom} data-subjects={n.tags.join(' ')}>
            <a class="title" href={`${base}/nodes/${n.id}/`}>{n.title}</a>
            <p>{n.summary}</p>
            <ul class="chips" style="margin-top:auto;padding-top:0.4rem">
              {n.tags.map((t) => <li><a class="chip" href={`#subject=${t}`}>{t}</a></li>)}
            </ul>
          </li>
          </>
        ))}
      </ul>
    </section>

    <section style="margin-top:2.6rem">
      <h2 style="margin-bottom:0.2rem"><Icon name="product" /> Product families</h2>
      <p style="color:var(--ink-soft);margin:0">
        The concepts above, assembled and sold. Every vendor here ships several
        products off one engine, so start with the family to see what is shared
        before comparing the members.
      </p>
      <ul class="cards">
        {suites.map((n) => (
          <li class="card is-suite" data-subjects={n.tags.join(' ')}>
            <a class="title" href={`${base}/nodes/${n.id}/`}>{n.title}</a>
            <p>{n.summary}</p>
          </li>
        ))}
      </ul>
    </section>

    <section style="margin-top:2.6rem">
      <h2 style="margin-bottom:0.2rem"><Icon name="product" /> Products</h2>
      <p style="color:var(--ink-soft);margin:0">
        The things you can actually buy or install, decomposed into the
        capabilities they ship. <a href={`${base}/compare`}>See them side by side.</a>
      </p>
      {
        byVendor.map((group) => (
          <>
            <h3 style="margin-bottom:0.2rem">{group.vendor}</h3>
            <ul class="cards">
              {group.nodes.map((n) => (
                <li class="card is-product" data-subjects={n.tags.join(' ')}>
                  <a class="title" href={`${base}/nodes/${n.id}/`}>{n.title}</a>
                  <p>{n.summary}</p>
                </li>
              ))}
            </ul>
          </>
        ))
      }
    </section>

  </div>
</Base>

<script>
  // Progressive enhancement, on two axes that compose. The page ships every
  // card and shows them all, so with JavaScript off the index is complete and
  // the subject links are ordinary anchors.
  //
  // The two axes are not the same kind of thing and are deliberately not drawn
  // as one: a level is how deep into the vocabulary you are, and applies to the
  // concepts; a subject is which part of the guide you are looking at, and
  // applies to everything on the page including the products.
  const control = document.querySelector<HTMLElement>('.zoom-control');
  const subjects = document.querySelector<HTMLElement>('.subject-control');
  // Every child carrying a level, not only the cards: the rules between levels
  // have to disappear with the cards they introduce, or level 1 shows a "Level
  // 3" heading with nothing under it.
  const cards = [...document.querySelectorAll<HTMLElement>('#concept-cards > [data-zoom]')];
  const all = [...document.querySelectorAll<HTMLElement>('.card[data-subjects]')];
  const blurb = document.querySelector<HTMLElement>('.zoom-blurb');
  if (control && subjects && cards.length && blurb) {
    const blurbs = JSON.parse(blurb.dataset.blurbs ?? '[]') as string[];
    const buttons = [...control.querySelectorAll<HTMLButtonElement>('button')];
    const links = [...subjects.querySelectorAll<HTMLAnchorElement>('a[data-subject]')];
    let level = 1;
    let subject = 'all';

    const matches = (c: HTMLElement) =>
      subject === 'all' || (c.dataset.subjects ?? '').split(' ').includes(subject);

    const apply = () => {
      for (const b of buttons) b.setAttribute('aria-pressed', String(Number(b.dataset.zoom) === level));
      for (const a of links) a.setAttribute('aria-current', String(a.dataset.subject === subject));

      for (const c of all) {
        const deep = c.dataset.zoom ? Number(c.dataset.zoom) > level : false;
        c.hidden = deep || !matches(c);
      }
      // Level rules carry a level but no subjects. Filtering by subject cuts
      // across the levels, so a rule can be left introducing an empty run.
      for (const rule of cards.filter((c) => !c.dataset.subjects)) {
        let empty = true;
        for (let n = rule.nextElementSibling; n instanceof HTMLElement && n.dataset.subjects; n = n.nextElementSibling) {
          if (!n.hidden) empty = false;
        }
        rule.hidden = empty || Number(rule.dataset.zoom) > level;
      }
      // A vendor with nothing under the chosen subject should not leave its
      // name behind over an empty row, and neither should a whole section.
      for (const list of document.querySelectorAll<HTMLElement>('ul.cards')) {
        const empty = ![...list.querySelectorAll<HTMLElement>('.card')].some((c) => !c.hidden);
        list.hidden = empty;
        const prev = list.previousElementSibling;
        if (prev instanceof HTMLElement && prev.tagName === 'H3') prev.hidden = empty;
      }
      for (const section of document.querySelectorAll<HTMLElement>('main section, .wrap > section')) {
        if (section.querySelector('#concept-cards')) continue; // keeps the controls visible
        section.hidden = ![...section.querySelectorAll<HTMLElement>('.card')].some((c) => !c.hidden);
      }

      // Counted across every card, not the concepts alone: `assistant` is
      // carried by three products and no concept, and counting concepts said
      // "0 pages about assistant" with three of them visible underneath.
      const shown = all.filter((c) => !c.hidden).length;
      const deeper = cards.filter((c) => c.dataset.subjects && c.hidden && matches(c)).length;
      blurb.textContent =
        subject === 'all'
          ? (blurbs[level - 1] ?? '')
          : `${shown} page${shown === 1 ? '' : 's'} about ${subject}` +
            (deeper ? `, with ${deeper} more at a finer level` : '') +
            '. A page can sit under several subjects, so narrowing to one never takes it out of the others.';
      try {
        localStorage.setItem('fg-zoom', String(level));
      } catch {
        /* private mode, or storage disabled — the controls still work */
      }
    };

    control.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-zoom]');
      if (!b) return;
      level = Number(b.dataset.zoom);
      apply();
    });

    // Driven by the hash rather than by the click, so that a subject chip on a
    // concept page lands here already narrowed, and so the browser's back
    // button steps through the subjects a reader has looked at.
    const fromHash = () => {
      const m = /^#subject=(.+)$/.exec(location.hash);
      const wanted = m ? decodeURIComponent(m[1]) : 'all';
      subject = links.some((a) => a.dataset.subject === wanted) ? wanted : 'all';
      // Arriving on a subject means "show me everything about this", so the
      // level opens all the way rather than hiding most of the answer.
      if (subject !== 'all') level = 3;
      apply();
    };
    window.addEventListener('hashchange', fromHash);

    try {
      const saved = Number(localStorage.getItem('fg-zoom'));
      if (saved >= 1 && saved <= 3) level = saved;
    } catch {
      /* fall back to the first level */
    }
    fromHash();
  }
</script>
